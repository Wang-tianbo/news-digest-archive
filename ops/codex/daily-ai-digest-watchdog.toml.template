version = 1
id = "daily-ai-digest-watchdog"
kind = "cron"
name = "Daily AI Digest Watchdog"
prompt = """
Before doing any work, determine the current time in Asia/Shanghai.

- If the current Asia/Shanghai time is not between 09:35:00 and 09:49:59, exit immediately with a concise no-op note and make no file or git changes.
- If it is within that window, check whether today's daily AI digest exists at `daily/YYYY/YYYY-MM/YYYY-MM-DD.md`.

Use the current Asia/Shanghai date as the report date. If today's digest already exists:
- Do not modify repository files.
- Update the automation memory with a concise success check.
- Return a concise summary saying the watchdog verified the digest exists.

If today's digest is missing:
- Treat this as a failed primary daily run and generate the missing daily AI digest for the same prior 09:00 to current 09:00 Asia/Shanghai bucket.
- Follow the same report requirements as `daily-ai-digest-archive`: read `README.md`, `docs/coverage-map.md`, `docs/editorial-guidelines.md`, `docs/source-watchlist.md`, `docs/automation-spec.md`, and `templates/daily-report-template.md`.
- Prefer official primary sources and exact deep links.
- Keep the report concise and high signal.
- Avoid repeating recent daily reports unless there is a materially new update.
- Include `结构化快照`, `主线判断`, `今日评论与判断`, `AI 新闻`, optional `AI 圈博主` when there is a high-value clue, opinion sample, methodology note, or practice review, optional `AI 研究前沿` when there is a high-value paper or research signal, `结构化索引`, `今日结构化结论`, and `参考来源`.
- Treat personal viewpoints and curated social posts as clue or opinion samples, not as factual confirmation. `AI 圈博主` entries must include `类型：信息线索 / 观点判断 / 方法论 / 实践复盘`; if no high-value clue or opinion sample is included, set `opinion_sources: []` and `viewpoint_themes: []` in the YAML metadata.
- `AI 研究前沿` entries must include an original source link and may include `权威解读` only as auxiliary interpretation; if no high-value research item is included, set `research_sources: []`, `research_themes: []`, `research_artifacts: []`, and `research_interpretations: []` in the YAML metadata.
- In the report header, state that it was generated by the watchdog because the primary daily automation did not produce the file by 09:35.

Git requirements when backfilling:
- Sync with `origin/main` before writing if needed.
- Stage only the generated digest file.
- Commit with `docs: add ai digest for YYYY-MM-DD` or `docs: update ai digest for YYYY-MM-DD`.
- Push to `origin main`.
- Do not use destructive git commands and do not modify unrelated files.

Report a concise watchdog summary with the checked path, whether the primary digest existed, whether a backfill was generated, and the pushed commit hash or exact blocker.
"""
status = "ACTIVE"
rrule = __RRULE_WATCHDOG_JSON__
model = "gpt-5.5"
reasoning_effort = "high"
execution_environment = "local"
cwds = [__REPO_ROOT_JSON__]
created_at = __CREATED_AT_MS__
updated_at = __UPDATED_AT_MS__
