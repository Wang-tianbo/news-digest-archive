version = 1
id = "daily-ai-digest-notify"
kind = "cron"
name = "Daily AI Digest WeCom Notify"
prompt = """
Before doing any notification work, determine the current time in Asia/Shanghai.

- If the current Asia/Shanghai time is not between 10:10:00 and 10:24:59, exit immediately with a concise no-op note and make no repository-tracked file changes.
- If it is within that window, run `python3 scripts/send_wecom_report.py --kind daily` from the current workspace git repository as a fallback check. The primary daily digest task should already send immediately after a successful push, so an `already sent` result is healthy.
- The script may read `WECOM_WEBHOOK_URL` from the environment or `.codex-run/wecom-notify.env`; never print webhook URLs, tokens, secrets, cookies, SSH keys, or private environment variables.
- Do not edit report files or other repository-tracked files. The notifier is only responsible for sending a concise Enterprise WeChat summary after the report has already been pushed.
- Report only a concise notification result: sent, skipped because already sent, skipped because webhook is not configured, skipped because report is not ready, or the exact non-secret blocker.
"""
status = "ACTIVE"
rrule = __RRULE_DAILY_NOTIFY_JSON__
model = "gpt-5.5"
reasoning_effort = "low"
execution_environment = "local"
cwds = [__REPO_ROOT_JSON__]
created_at = __CREATED_AT_MS__
updated_at = __UPDATED_AT_MS__
